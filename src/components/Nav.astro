---
import { Menu, X, Globe } from 'lucide-astro';
import Logo from './Logo.astro';

const links = [
  { href: '/services', label: 'Services' },
  { href: '/case-studies', label: 'Work' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Insights' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 border-b border-border">
  <nav class="container-toven flex items-center justify-between h-16 md:h-20">

    <!-- Logo -->
    <Logo />

    <!-- Desktop Links -->
    <ul class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            data-nav-link={link.href}
            class="nav-link text-sm font-medium transition-colors relative text-ink-muted hover:text-ink"
          >
            {link.label}
            <span class="nav-underline absolute -bottom-2 left-0 right-0 h-[2px] bg-lime rounded-full opacity-0 transition-opacity duration-300"></span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Desktop CTA -->
    <div class="hidden md:flex items-center gap-3">
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-lime text-ink text-sm font-semibold hover:bg-lime-hover transition-colors"
      >
        Book a demo
        <Globe size={14} />
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg text-ink"
      aria-label="Toggle menu"
    >
      <Menu id="menu-open-icon" size={22} />
      <X id="menu-close-icon" size={22} class="hidden" />
    </button>

  </nav>

  <!-- Mobile Menu Panel -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-white">
    <ul class="container-toven py-4 flex flex-col gap-1">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            data-nav-link={link.href}
            class="nav-link block px-3 py-3 rounded-lg transition-colors text-ink-muted hover:bg-surface-soft hover:text-ink"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-3 mt-2 border-t border-border">
        <a
          href="/contact"
          class="block text-center px-5 py-3 rounded-full bg-lime text-ink font-semibold hover:bg-lime-hover transition-colors"
        >
          Book a demo →
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // ============================================
  // Mobile menu toggle
  // ============================================
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // ============================================
  // Active nav link highlighting
  // ============================================
  const updateActiveNav = () => {
    const currentPath = window.location.pathname;

    document.querySelectorAll('.nav-link').forEach((link) => {
      const href = link.getAttribute('data-nav-link') || '';
      const isActive =
        currentPath === href || currentPath.startsWith(href + '/');

      const underline = link.querySelector('.nav-underline');

      if (isActive) {
        link.classList.remove('text-ink-muted');
        link.classList.add('text-ink');
        if (underline) underline.classList.remove('opacity-0');
      } else {
        link.classList.add('text-ink-muted');
        link.classList.remove('text-ink');
        if (underline) underline.classList.add('opacity-0');
      }
    });
  };

  // Run on initial page load
  updateActiveNav();

  // Re-run after Swup replaces content
  document.addEventListener('swup:contentReplaced', updateActiveNav);
  document.addEventListener('swup:page:view', updateActiveNav);

  // Fallback for native Astro view transitions
  document.addEventListener('astro:page-load', updateActiveNav);

  // Also on popstate (browser back/forward)
  window.addEventListener('popstate', updateActiveNav);
</script>