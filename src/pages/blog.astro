---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroHeading from '../components/HeroHeading.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredPost = posts.find(p => p.data.featured) || posts[0];
const otherPosts = featuredPost ? posts.filter(p => p.id !== featuredPost.id) : posts;

const getReadTime = (body: string | undefined) => {
  if (!body) return '1 min read';
  const words = body.split(/\s+/).length;
  const minutes = Math.max(1, Math.round(words / 200));
  return `${minutes} min read`;
};

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });

const categories = ['All', ...Array.from(new Set(posts.map(p => p.data.category)))];
---

<Layout
  title="Insights — Toven360°"
  description="Technical insights on AI agents, backend engineering, and digital infrastructure from the Toven360° team. Practical, honest, and production-tested."
>

  <!-- HERO -->
  <section class="relative gradient-sky pt-10 pb-10 md:pt-14 md:pb-12 overflow-hidden">
    <div class="container-toven relative z-10">
      <div class="max-w-4xl">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-6">
          Insights
        </p>
        <HeroHeading
          before="Engineering notes."
          highlight="From"
          after="production."
          rotate="right"
          color="lime"
          size="lg"
          class="mb-8"
        />
        <p class="text-lg md:text-xl text-ink-muted max-w-2xl leading-relaxed">
          Technical insights on AI agents, backend architecture, and digital infrastructure — written by engineers, for engineers and the teams that work with them.
        </p>
      </div>
    </div>
  </section>

  <!-- CATEGORIES -->
  <section class="py-12 bg-white border-b border-border">
    <div class="container-toven">
      <div class="flex flex-wrap gap-2">
        {categories.map((cat, i) => (
          <span
            class={`px-5 py-2.5 rounded-full text-sm font-semibold ${
              i === 0
                ? 'bg-ink text-white'
                : 'bg-surface-soft border border-border text-ink-muted'
            }`}
          >
            {cat}
          </span>
        ))}
      </div>
    </div>
  </section>

  {posts.length === 0 ? (
    <section class="py-32 bg-white">
      <div class="container-toven text-center">
        <p class="text-lg text-ink-muted">No insights published yet. Check back soon.</p>
      </div>
    </section>
  ) : (
    <>
      <!-- FEATURED POST -->
      {featuredPost && (
        <section class="py-24 bg-white">
          <div class="container-toven">
            <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-8">
              Featured
            </p>

            <a href={`/blog/${featuredPost.id}`} class="group block p-10 lg:p-14 rounded-[2.5rem] bg-surface-soft border border-border/60 hover:border-transparent hover:shadow-[0_30px_80px_-20px_rgba(10,14,26,0.18)] transition-all duration-500">
              <div class="grid lg:grid-cols-12 gap-10 items-center">

                <div class="lg:col-span-7">
                  <div class="flex items-center gap-4 mb-6">
                    <span class="text-xs font-semibold text-sky-accent uppercase tracking-widest px-3 py-1.5 rounded-full bg-sky-accent/10">
                      {featuredPost.data.category}
                    </span>
                    <span class="text-xs text-ink-subtle">{getReadTime(featuredPost.body)}</span>
                  </div>

                  <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-ink mb-6 leading-[1.1] tracking-tight">
                    {featuredPost.data.title}
                  </h2>

                  <p class="text-lg text-ink-muted leading-relaxed mb-8">
                    {featuredPost.data.description}
                  </p>

                  <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-full bg-ink flex items-center justify-center text-white font-bold text-sm">
                      TS
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-ink">{featuredPost.data.author}</p>
                      <p class="text-xs text-ink-subtle">{formatDate(featuredPost.data.date)}</p>
                    </div>
                  </div>
                </div>

                <div class="lg:col-span-5">
                  <div class="aspect-[4/3] rounded-[2rem] overflow-hidden bg-ink">
                    {featuredPost.data.cover ? (
                      <img
                        src={featuredPost.data.cover}
                        alt={featuredPost.data.coverAlt || featuredPost.data.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                        loading="lazy"
                      />
                    ) : (
                      <img
                        src={`/og/${featuredPost.id}`}
                        alt={featuredPost.data.title}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    )}
                  </div>
                </div>

              </div>
            </a>
          </div>
        </section>
      )}

      <!-- POST GRID -->
      <section class="py-24 bg-white">
        <div class="container-toven">

          <div class="max-w-3xl mb-16">
            <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
              All articles
            </p>
            <h2 class="text-4xl md:text-5xl font-extrabold text-ink leading-[1.05] tracking-tight">
              Latest from<br />
              <span class="text-ink-subtle">the engineering team.</span>
            </h2>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {otherPosts.map((post) => (
              <a href={`/blog/${post.id}`} class="group p-0 rounded-[2rem] bg-surface-soft border border-border/60 hover:border-transparent hover:shadow-[0_20px_60px_-15px_rgba(10,14,26,0.12)] hover:-translate-y-1 transition-all duration-500 flex flex-col overflow-hidden">

                <div class="aspect-[16/10] overflow-hidden bg-ink">
                  {post.data.cover ? (
                    <img
                      src={post.data.cover}
                      alt={post.data.coverAlt || post.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                      loading="lazy"
                    />
                  ) : (
                    <img
                      src={`/og/${post.id}`}
                      alt={post.data.title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  )}
                </div>

                <div class="p-8 pt-6 flex-1 flex flex-col">

                  <div class="flex items-center justify-between mb-6">
                    <span class="text-xs font-semibold text-sky-accent uppercase tracking-widest">
                      {post.data.category}
                    </span>
                    <span class="text-xs text-ink-subtle">{getReadTime(post.body)}</span>
                  </div>

                  <h3 class="text-xl font-bold text-ink mb-3 tracking-tight leading-snug">
                    {post.data.title}
                  </h3>

                  <p class="text-sm text-ink-muted leading-relaxed mb-8 flex-1">
                    {post.data.description}
                  </p>

                  <div class="pt-6 border-t border-border flex items-center justify-between">
                    <span class="text-xs text-ink-subtle">{formatDate(post.data.date)}</span>
                    <span class="inline-flex items-center gap-2 text-sm font-semibold text-ink group-hover:gap-3 transition-all">
                      Read
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                      </svg>
                    </span>
                  </div>

                </div>

              </a>
            ))}
          </div>

        </div>
      </section>
    </>
  )}

  <!-- CTA -->
  <section class="py-24 bg-white">
    <div class="container-toven">
      <div class="relative rounded-[2.5rem] bg-gradient-sky overflow-hidden p-12 md:p-20 text-center">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full bg-white/40 blur-3xl pointer-events-none"></div>
        <div class="relative">
          <h2 class="text-4xl md:text-5xl font-extrabold text-ink mb-6 leading-[1.05] tracking-tight">
            Build with us.
          </h2>
          <p class="text-lg text-ink-muted max-w-xl mx-auto mb-10">
            Reading is one thing. Shipping is another. Book a discovery call when you are ready to move.
          </p>
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-ink text-white font-semibold hover:bg-ink-soft transition-colors">
            Book a discovery call →
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>