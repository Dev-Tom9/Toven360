---
import Layout from '../layouts/Layout.astro';
import HeroHeading from '../components/HeroHeading.astro';
---

<Layout
  title="Contact — Toven360°"
  description="Book a discovery call or send a message. Direct access to senior engineering — no sales layers, no noise."
>

  <!-- HERO -->
  <section class="relative gradient-sky pt-10 pb-10 md:pt-14 md:pb-12 overflow-hidden">
    <div class="container-toven relative z-10">
      <div class="max-w-4xl">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-6">
          Contact
        </p>
        <HeroHeading
          before="Let's talk."
          highlight="No"
          after="sales theatre."
          rotate="right"
          color="lime"
          size="lg"
          class="mb-8"
        />
        <p class="text-lg md:text-xl text-ink-muted max-w-2xl leading-relaxed">
          Book a discovery call or send a message. You'll hear back from a senior engineer, not a sales rep.
        </p>
      </div>
    </div>
  </section>

  <!-- CONTACT BODY -->
  <section class="py-24 bg-white">
    <div class="container-toven">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">

        <!-- LEFT -->
        <div>
          <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
            Direct channels
          </p>
          <h2 class="text-3xl md:text-4xl font-extrabold text-ink mb-8 leading-[1.1] tracking-tight">
            Reach us<br />
            <span class="text-ink-subtle">your way.</span>
          </h2>

          <div class="space-y-4 mb-10">

            <a href="mailto:thetovengroup@gmail.com" class="group flex items-center gap-5 p-5 rounded-2xl bg-surface-soft border border-border/60 hover:border-transparent hover:shadow-[0_20px_60px_-15px_rgba(10,14,26,0.12)] transition-all duration-500">
              <div class="w-11 h-11 rounded-xl bg-sky-accent/15 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-accent">
                  <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-ink-subtle uppercase tracking-widest mb-1">Email</p>
                <p class="text-base font-bold text-ink truncate">thetovengroup@gmail.com</p>
              </div>
            </a>

            <a href="https://cal.com/toven360/discovery" target="_blank" rel="noopener" class="group flex items-center gap-5 p-5 rounded-2xl bg-surface-soft border border-border/60 hover:border-transparent hover:shadow-[0_20px_60px_-15px_rgba(10,14,26,0.12)] transition-all duration-500">
              <div class="w-11 h-11 rounded-xl bg-lime/40 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink">
                  <rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-ink-subtle uppercase tracking-widest mb-1">Discovery call</p>
                <p class="text-base font-bold text-ink">Book a 30-min call →</p>
              </div>
            </a>

            <a href="https://linkedin.com" target="_blank" rel="noopener" class="group flex items-center gap-5 p-5 rounded-2xl bg-surface-soft border border-border/60 hover:border-transparent hover:shadow-[0_20px_60px_-15px_rgba(10,14,26,0.12)] transition-all duration-500">
              <div class="w-11 h-11 rounded-xl bg-sky-deep/20 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-deep">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-ink-subtle uppercase tracking-widest mb-1">LinkedIn</p>
                <p class="text-base font-bold text-ink">Connect with Toven360°</p>
              </div>
            </a>

          </div>

          <div class="p-6 rounded-2xl bg-ink text-white mb-6">
            <p class="text-xs font-semibold text-lime uppercase tracking-widest mb-3">
              Response time
            </p>
            <p class="text-sm text-white/80 leading-relaxed">
              We respond to all enquiries within 24 hours, Monday–Friday. Urgent requests? Mention it in the message.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-surface-soft border border-border/60">
            <p class="text-xs font-semibold text-ink-subtle uppercase tracking-widest mb-4">
              Available worldwide
            </p>
            <div class="flex flex-wrap gap-2 text-xs text-ink-muted">
              <span class="px-3 py-1.5 rounded-full bg-white border border-border">EST · PST</span>
              <span class="px-3 py-1.5 rounded-full bg-white border border-border">GMT · CET</span>
              <span class="px-3 py-1.5 rounded-full bg-white border border-border">GST · AST</span>
              <span class="px-3 py-1.5 rounded-full bg-white border border-border">WAT · SAST</span>
            </div>
          </div>

        </div>

        <!-- RIGHT: Contact form -->
        <div class="p-8 lg:p-10 rounded-[2.5rem] bg-surface-soft border border-border/60">

          <div class="mb-8">
            <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
              Send a message
            </p>
            <h2 class="text-3xl md:text-4xl font-extrabold text-ink leading-[1.1] tracking-tight">
              Tell us about<br />
              <span class="text-ink-subtle">your project.</span>
            </h2>
          </div>

          <form
            action="https://formspree.io/f/your-form-id"
            method="POST"
            class="space-y-5"
          >

            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-xs font-semibold text-ink-subtle uppercase tracking-widest mb-2">
                  Name
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Your full name"
                  class="w-full px-5 py-3.5 rounded-xl bg-white border border-border focus:border-sky-accent focus:outline-none focus:ring-2 focus:ring-sky-accent/20 transition-all text-ink placeholder:text-ink-subtle/60 text-sm"
                />
              </div>
              <div>
                <label for="email" class="block text-xs font-semibold text-ink-subtle uppercase tracking-widest mb-2">
                  Email
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="you@company.com"
                  class="w-full px-5 py-3.5 rounded-xl bg-white border border-border focus:border-sky-accent focus:outline-none focus:ring-2 focus:ring-sky-accent/20 transition-all text-ink placeholder:text-ink-subtle/60 text-sm"
                />
              </div>
            </div>

            <div>
              <label for="company" class="block text-xs font-semibold text-ink-subtle uppercase tracking-widest mb-2">
                Company <span class="text-ink-subtle/50 normal-case tracking-normal">(optional)</span>
              </label>
              <input
                type="text"
                id="company"
                name="company"
                placeholder="Company name"
                class="w-full px-5 py-3.5 rounded-xl bg-white border border-border focus:border-sky-accent focus:outline-none focus:ring-2 focus:ring-sky-accent/20 transition-all text-ink placeholder:text-ink-subtle/60 text-sm"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-ink-subtle uppercase tracking-widest mb-2">
                What can we help with?
              </label>

              <input type="hidden" id="service" name="service" required />

              <div class="relative" id="service-dropdown">

                <button
                  type="button"
                  id="service-trigger"
                  class="w-full px-5 py-3.5 rounded-xl bg-white border border-border hover:border-sky-accent/50 focus:border-sky-accent focus:outline-none focus:ring-2 focus:ring-sky-accent/20 transition-all text-left flex items-center justify-between gap-3 text-sm"
                >
                  <span id="service-label" class="text-ink-subtle/60">Select a service</span>
                  <svg id="service-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink-subtle transition-transform duration-300 flex-shrink-0">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </button>

                <div
                  id="service-menu"
                  class="hidden absolute z-50 left-0 right-0 mt-2 p-2 rounded-2xl bg-white border border-border shadow-[0_20px_60px_-15px_rgba(10,14,26,0.25)] opacity-0 -translate-y-2 transition-all duration-200"
                >
                  <button type="button" data-value="software-development" class="service-option group w-full flex items-center justify-between gap-3 px-4 py-3 rounded-xl text-left text-sm text-ink hover:bg-surface-soft transition-colors">
                    <span>Software Development</span>
                    <svg class="service-check opacity-0 group-[.selected]:opacity-100 text-sky-accent" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </button>

                  <button type="button" data-value="ai-agents" class="service-option group w-full flex items-center justify-between gap-3 px-4 py-3 rounded-xl text-left text-sm text-ink hover:bg-surface-soft transition-colors">
                    <span>AI Agents &amp; Automation</span>
                    <svg class="service-check opacity-0 group-[.selected]:opacity-100 text-sky-accent" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </button>

                  <button type="button" data-value="infrastructure" class="service-option group w-full flex items-center justify-between gap-3 px-4 py-3 rounded-xl text-left text-sm text-ink hover:bg-surface-soft transition-colors">
                    <span>Digital Infrastructure</span>
                    <svg class="service-check opacity-0 group-[.selected]:opacity-100 text-sky-accent" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </button>

                  <button type="button" data-value="consulting" class="service-option group w-full flex items-center justify-between gap-3 px-4 py-3 rounded-xl text-left text-sm text-ink hover:bg-surface-soft transition-colors">
                    <span>Technical Consulting</span>
                    <svg class="service-check opacity-0 group-[.selected]:opacity-100 text-sky-accent" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </button>

                  <button type="button" data-value="custom-project" class="service-option group w-full flex items-center justify-between gap-3 px-4 py-3 rounded-xl text-left text-sm text-ink hover:bg-surface-soft transition-colors">
                    <span>Custom project</span>
                    <svg class="service-check opacity-0 group-[.selected]:opacity-100 text-sky-accent" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </button>

                  <button type="button" data-value="general-enquiry" class="service-option group w-full flex items-center justify-between gap-3 px-4 py-3 rounded-xl text-left text-sm text-ink hover:bg-surface-soft transition-colors">
                    <span>General enquiry</span>
                    <svg class="service-check opacity-0 group-[.selected]:opacity-100 text-sky-accent" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </button>

                  <button type="button" data-value="not-sure-yet" class="service-option group w-full flex items-center justify-between gap-3 px-4 py-3 rounded-xl text-left text-sm text-ink hover:bg-surface-soft transition-colors">
                    <span>Not sure yet</span>
                    <svg class="service-check opacity-0 group-[.selected]:opacity-100 text-sky-accent" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </button>
                </div>

              </div>
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold text-ink-subtle uppercase tracking-widest mb-2">
                Project details
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Tell us what you're building, what stage you're at, and what success looks like."
                class="w-full px-5 py-3.5 rounded-xl bg-white border border-border focus:border-sky-accent focus:outline-none focus:ring-2 focus:ring-sky-accent/20 transition-all text-ink placeholder:text-ink-subtle/60 resize-none text-sm"
              ></textarea>
            </div>

            <input type="text" name="_gotcha" style="display:none" />

            <button
              type="submit"
              class="w-full inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-ink text-white font-semibold hover:bg-ink-soft transition-colors"
            >
              Send message
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </button>

          </form>

        </div>

      </div>
    </div>
  </section>

  <!-- BOOK A CALL -->
  <section class="py-24 bg-surface-soft">
    <div class="container-toven">
      <div class="max-w-3xl mb-12">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
          Book directly
        </p>
        <h2 class="text-4xl md:text-5xl font-extrabold text-ink leading-[1.05] tracking-tight mb-4">
          Pick a time.<br />
          <span class="text-ink-subtle">Let's talk.</span>
        </h2>
        <p class="text-lg text-ink-muted leading-relaxed">
          30-minute discovery call. Select a slot below — you'll get a calendar invite and video link instantly.
        </p>
      </div>

      <div class="rounded-[2.5rem] bg-white border border-border/60 overflow-hidden p-2 md:p-4">
        <div id="my-cal-inline" class="w-full min-h-[600px] rounded-[2rem] overflow-hidden relative">
          <div id="cal-loading" class="absolute inset-0 flex items-center justify-center bg-surface-soft">
            <div class="text-center">
              <div class="w-10 h-10 rounded-full border-4 border-sky-light border-t-sky-accent animate-spin mx-auto mb-4"></div>
              <p class="text-sm text-ink-muted">Loading calendar…</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-white">
    <div class="container-toven">
      <div class="relative rounded-[2.5rem] bg-gradient-sky overflow-hidden p-12 md:p-20 text-center">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full bg-white/40 blur-3xl pointer-events-none"></div>
        <div class="relative">
          <h2 class="text-4xl md:text-5xl font-extrabold text-ink mb-6 leading-[1.05] tracking-tight">
            Send a message instead?
          </h2>
          <p class="text-lg text-ink-muted max-w-xl mx-auto mb-10">
            Not ready to book? Fill the form above or email us — we respond within 24 hours.
          </p>
          <a href="mailto:thetovengroup@gmail.com" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-ink text-white font-semibold hover:bg-ink-soft transition-colors">
            Email us →
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  // ============================================
  // Custom Dropdown
  // ============================================
  function initDropdown() {
    const dropdown = document.getElementById('service-dropdown');
    const trigger = document.getElementById('service-trigger');
    const menu = document.getElementById('service-menu');
    const label = document.getElementById('service-label');
    const chevron = document.getElementById('service-chevron');
    const hiddenInput = document.getElementById('service') as HTMLInputElement;
    const options = document.querySelectorAll('.service-option');

    if (!trigger || !menu) return;
    if ((trigger as any)._dropdownBound) return;
    (trigger as any)._dropdownBound = true;

    let isOpen = false;

    const openMenu = () => {
      isOpen = true;
      menu.classList.remove('hidden');
      requestAnimationFrame(() => {
        menu.classList.remove('opacity-0', '-translate-y-2');
      });
      chevron?.classList.add('rotate-180');
    };

    const closeMenu = () => {
      isOpen = false;
      menu.classList.add('opacity-0', '-translate-y-2');
      chevron?.classList.remove('rotate-180');
      setTimeout(() => {
        if (!isOpen) menu.classList.add('hidden');
      }, 200);
    };

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      isOpen ? closeMenu() : openMenu();
    });

    options.forEach((option) => {
      option.addEventListener('click', () => {
        const value = option.getAttribute('data-value') || '';
        const text = option.querySelector('span')?.textContent || 'Select a service';

        if (hiddenInput) hiddenInput.value = value;

        if (label) {
          label.textContent = text;
          label.classList.remove('text-ink-subtle/60');
          label.classList.add('text-ink');
        }

        options.forEach((o) => o.classList.remove('selected'));
        option.classList.add('selected');

        closeMenu();
      });
    });

    document.addEventListener('click', (e) => {
      if (isOpen && !dropdown?.contains(e.target as Node)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
        trigger?.focus();
      }
    });
  }

  // ============================================
  // Cal.com Embed — force full reinit on every nav
  // ============================================
  function loadCalScript(): Promise<void> {
    return new Promise((resolve) => {
      // If Cal is already loaded globally and functional, resolve
      if ((window as any).Cal && (window as any).Cal.loaded) {
        resolve();
        return;
      }

      // Otherwise, inject the script fresh
      const existing = document.querySelector('script[src*="cal.com/embed"]');
      if (existing) existing.remove();

      (function (C: any, A: string, L: string) {
        const p = function (a: any, ar: any) { a.q.push(ar); };
        const d = C.document;
        C.Cal = C.Cal || function () {
          const cal = C.Cal;
          const ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api: any = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
      })(window as any, "https://app.cal.com/embed/embed.js", "init");

      setTimeout(resolve, 50);
    });
  }

  function reinitCal() {
    const container = document.getElementById('my-cal-inline');
    if (!container) return;

    // Wipe the container so Cal has a fresh target
    container.innerHTML = '';

    // Restore the loading spinner
    container.innerHTML = `
      <div id="cal-loading" class="absolute inset-0 flex items-center justify-center bg-surface-soft">
        <div class="text-center">
          <div class="w-10 h-10 rounded-full border-4 border-sky-light border-t-sky-accent animate-spin mx-auto mb-4"></div>
          <p class="text-sm text-ink-muted">Loading calendar…</p>
        </div>
      </div>
    `;

    // Reset Cal's internal state so it re-renders
    if ((window as any).Cal) {
      (window as any).Cal.loaded = false;
      if ((window as any).Cal.ns) {
        delete (window as any).Cal.ns['discovery'];
      }
    }

    // Remove the old Cal embed script
    const oldScript = document.querySelector('script[src*="cal.com/embed/embed.js"]');
    if (oldScript) oldScript.remove();

    // Now re-init
    loadCalScript().then(() => {
      try {
        (window as any).Cal("init", "discovery", { origin: "https://cal.com" });

        (window as any).Cal.ns["discovery"]("inline", {
          elementOrSelector: "#my-cal-inline",
          config: { layout: "month_view", theme: "light" },
          calLink: "toven360/discovery"
        });

        (window as any).Cal.ns["discovery"]("ui", {
          theme: "light",
          styles: { branding: { brandColor: "#0a0e1a" } },
          hideEventTypeDetails: false,
          layout: "month_view"
        });

        // Hide loading after Cal finishes mounting
        const checkLoaded = setInterval(() => {
          const iframe = container.querySelector('iframe');
          if (iframe) {
            clearInterval(checkLoaded);
            const loading = document.getElementById('cal-loading');
            if (loading) loading.remove();
          }
        }, 100);

        // Timeout fallback
        setTimeout(() => {
          clearInterval(checkLoaded);
          const loading = document.getElementById('cal-loading');
          if (loading) loading.remove();
        }, 5000);
      } catch (err) {
        console.error('Cal init error:', err);
      }
    });
  }

  function initAll() {
    initDropdown();
    reinitCal();
  }

  // Initial page load
  if (document.readyState === 'complete') {
    initAll();
  } else {
    window.addEventListener('load', initAll);
  }

  // Swup navigation
  document.addEventListener('swup:contentReplaced', () => setTimeout(initAll, 100));
  document.addEventListener('swup:page:view', () => setTimeout(initAll, 100));
  document.addEventListener('astro:page-load', () => setTimeout(initAll, 100));
  window.addEventListener('popstate', () => setTimeout(initAll, 200));
</script>