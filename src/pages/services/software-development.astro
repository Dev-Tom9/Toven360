---
import Layout from '../../layouts/Layout.astro';

const deliverables = [
  {
    title: 'Custom Backend Systems',
    description: 'Node.js, Python, Go — architected for scale, observability, and long-term maintainability.',
    icon: '<rect width="20" height="14" x="2" y="5" rx="2"/><path d="m2 10 20 0"/><path d="M6 15h.01"/><path d="M10 15h.01"/>',
  },
  {
    title: 'REST & GraphQL APIs',
    description: 'Versioned, documented, and secure APIs. Built to be consumed by teams, not just machines.',
    icon: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  },
  {
    title: 'Database Architecture',
    description: 'Schema design, indexing strategy, query optimization, and migration planning.',
    icon: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>',
  },
  {
    title: 'Full-Stack Applications',
    description: 'End-to-end web apps — from UI to infrastructure — delivered by one accountable team.',
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  },
  {
    title: 'Third-Party Integrations',
    description: 'Payments, auth, CRMs, messaging, and custom middleware — wired up cleanly.',
    icon: '<path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 0 1 0 10h-2"/><line x1="8" x2="16" y1="12" y2="12"/>',
  },
  {
    title: 'Maintenance & Support',
    description: 'Ongoing engineering support. Bug fixes, refactors, performance work, and feature delivery.',
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  },
];

const process = [
  { step: '01', title: 'Discovery', description: 'Scope, requirements, and constraints. We listen first.' },
  { step: '02', title: 'Architecture', description: 'System design, tech selection, and delivery plan.' },
  { step: '03', title: 'Build', description: 'Iterative development with weekly demos and checkpoints.' },
  { step: '04', title: 'Ship & Support', description: 'Deployment, monitoring, and ongoing engineering support.' },
];

const stack = ['Node.js', 'Python', 'Go', 'PostgreSQL', 'MongoDB', 'Redis', 'GraphQL', 'REST', 'TypeScript', 'Docker'];
---

<Layout
  title="Software Development — Toven360°"
  description="Custom backend systems, APIs, and full-stack applications engineered for scale, security, and long-term maintainability."
>

  <!-- HERO -->
  <section class="relative gradient-sky pt-10 pb-12 md:pt-14 md:pb-16 overflow-hidden">
    <div class="container-toven relative z-10">
      <div class="max-w-4xl">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-6">
          Service · Software Development
        </p>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold text-ink mb-8 leading-[1.05] tracking-tight" style="font-family: var(--font-hero);">
          Software that's built<br />
          <span class="text-gradient">to last.</span>
        </h1>
        <p class="text-lg md:text-xl text-ink-muted max-w-2xl leading-relaxed mb-10">
          Custom backend systems, APIs, and full-stack applications — engineered for scale, security, and long-term maintainability.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-ink text-white font-semibold hover:bg-ink-soft transition-colors">
            Start a project
          </a>
          <a href="/services" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-white text-ink font-semibold border border-border hover:border-ink transition-colors">
            ← All services
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="py-24 bg-white">
    <div class="container-toven">
      <div class="grid lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-5">
          <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
            The approach
          </p>
          <h2 class="text-4xl md:text-5xl font-extrabold text-ink leading-[1.05] tracking-tight">
            Engineering first.<br />
            <span class="text-ink-subtle">Everything else follows.</span>
          </h2>
        </div>
        <div class="lg:col-span-7">
          <p class="text-lg text-ink-muted leading-relaxed mb-6">
            Most software agencies sell you speed. We sell you systems that don't need to be rewritten in 18 months. Every engagement is led by a Senior Backend Engineer — not a project manager relaying messages.
          </p>
          <p class="text-lg text-ink-muted leading-relaxed">
            We build for the long term: clear architecture, tested code, documented decisions, and infrastructure that scales without drama.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- DELIVERABLES -->
  <section class="relative py-32 bg-surface-soft overflow-hidden">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] rounded-full bg-sky-light/50 blur-3xl pointer-events-none"></div>

    <div class="container-toven relative">
      <div class="max-w-3xl mb-16">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
          What's included
        </p>
        <h2 class="text-4xl md:text-5xl font-extrabold text-ink leading-[1.05] tracking-tight">
          Full-stack delivery,<br />
          <span class="text-ink-subtle">end to end.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {deliverables.map((item) => (
          <div class="group p-8 rounded-[2rem] bg-white border border-border/60 hover:border-transparent hover:shadow-[0_20px_60px_-15px_rgba(10,14,26,0.12)] transition-all duration-500">
            <div class="w-12 h-12 rounded-xl bg-sky-accent/15 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:rotate-3 transition-all duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-sky-accent" set:html={item.icon} />
            </div>
            <h3 class="text-lg font-bold text-ink mb-3 tracking-tight">{item.title}</h3>
            <p class="text-sm text-ink-muted leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-32 bg-white">
    <div class="container-toven">
      <div class="max-w-3xl mb-20">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
          How we work
        </p>
        <h2 class="text-4xl md:text-5xl font-extrabold text-ink leading-[1.05] tracking-tight">
          A process built<br />
          <span class="text-ink-subtle">for clarity.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {process.map((item, i) => {
          const numberColors = [
            'text-sky-accent/40',
            'text-yellow-500/40',
            'text-sky-deep/40',
            'text-red-500/40',
          ];
          return (
            <div class="relative">
              <div class={`text-6xl md:text-7xl font-extrabold mb-4 leading-none ${numberColors[i]}`} style="font-family: var(--font-hero);">
                {item.step}
              </div>
              <h3 class="text-xl font-bold text-ink mb-3 tracking-tight">{item.title}</h3>
              <p class="text-sm text-ink-muted leading-relaxed">{item.description}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- TECH STACK -->
  <section class="py-24 bg-ink text-white">
    <div class="container-toven">
      <div class="max-w-3xl mb-12">
        <p class="text-xs font-semibold text-lime uppercase tracking-[0.2em] mb-4">
          Tech we use
        </p>
        <h2 class="text-3xl md:text-4xl font-extrabold leading-[1.1] tracking-tight">
          Battle-tested tools.<br />
          <span class="text-white/50">No hype cycles.</span>
        </h2>
      </div>

      <div class="flex flex-wrap gap-3">
        {stack.map((tech) => (
          <span class="px-5 py-2.5 rounded-full bg-white/5 border border-white/10 text-sm font-medium text-white/80 hover:bg-white/10 hover:border-white/20 transition-colors">
            {tech}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-white">
    <div class="container-toven">
      <div class="relative rounded-[2.5rem] bg-gradient-sky overflow-hidden p-12 md:p-20 text-center">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full bg-white/40 blur-3xl pointer-events-none"></div>
        <div class="relative">
          <h2 class="text-4xl md:text-5xl font-extrabold text-ink mb-6 leading-[1.05] tracking-tight">
            Got a system to build?
          </h2>
          <p class="text-lg text-ink-muted max-w-xl mx-auto mb-10">
            Book a discovery call. We'll scope it honestly — no sales theatre.
          </p>
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-ink text-white font-semibold hover:bg-ink-soft transition-colors">
            Book a discovery call →
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>