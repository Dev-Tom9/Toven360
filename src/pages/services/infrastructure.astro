---
import Layout from '../../layouts/Layout.astro';

const deliverables = [
  {
    title: 'Cloud Architecture',
    description: 'AWS, GCP, Azure, IBM Cloud — designed for reliability, cost efficiency, and scale from day one.',
    icon: '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9z"/>',
  },
  {
    title: 'CI/CD Pipelines',
    description: 'Automated build, test, and deploy pipelines that make shipping boring and safe.',
    icon: '<path d="M21 12a9 9 0 1 1-9-9"/><path d="M21 3v6h-6"/><circle cx="12" cy="12" r="2"/>',
  },
  {
    title: 'Kubernetes & Containers',
    description: 'Orchestration, autoscaling, and cluster management — production-grade, not toy demos.',
    icon: '<path d="M12 2 4 7v10l8 5 8-5V7z"/><path d="M12 22V12"/><path d="m4 7 8 5 8-5"/>',
  },
  {
    title: 'Infrastructure as Code',
    description: 'Terraform and Pulumi. Reproducible environments. No snowflake servers.',
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/><line x1="14" y1="4" x2="10" y2="20"/>',
  },
  {
    title: 'Observability & Monitoring',
    description: 'Metrics, logs, traces, and alerting — so issues surface before users notice them.',
    icon: '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>',
  },
  {
    title: 'Cost Optimization',
    description: 'Reduce cloud spend without sacrificing performance. Often 30 to 50 percent savings.',
    icon: '<line x1="12" y1="2" x2="12" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  },
];

const process = [
  { step: '01', title: 'Audit', description: 'Full review of current infrastructure, spend, and reliability posture.' },
  { step: '02', title: 'Design', description: 'Target architecture — practical, right-sized, and cost-aware.' },
  { step: '03', title: 'Migrate', description: 'Incremental migration with zero downtime and rollback paths.' },
  { step: '04', title: 'Operate', description: 'Ongoing support, tuning, and cost governance.' },
];

const stack = ['AWS', 'GCP', 'Azure', 'IBM Cloud', 'Kubernetes', 'Terraform', 'Pulumi', 'Docker', 'GitHub Actions', 'Grafana'];
---

<Layout
  title="Digital Infrastructure — Toven360°"
  description="Enterprise-grade cloud architecture, DevOps, and infrastructure — designed and deployed by an IBM Solution Architect. Built for reliability, cost efficiency, and scale."
>

  <!-- HERO -->
  <section class="relative gradient-sky pt-10 pb-12 md:pt-14 md:pb-16 overflow-hidden">
    <div class="container-toven relative z-10">
      <div class="max-w-4xl">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-6">
          Service · Digital Infrastructure
        </p>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold text-ink mb-8 leading-[1.05] tracking-tight" style="font-family: var(--font-hero);">
          Infrastructure<br />
          <span class="text-gradient">built to hold.</span>
        </h1>
        <p class="text-lg md:text-xl text-ink-muted max-w-2xl leading-relaxed mb-10">
          Enterprise-grade cloud architecture and DevOps — designed by an IBM Solution Architect. Built for reliability, cost efficiency, and scale.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-ink text-white font-semibold hover:bg-ink-soft transition-colors">
            Start a project
          </a>
          <a href="/services" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-white text-ink font-semibold border border-border hover:border-ink transition-colors">
            ← All services
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="py-24 bg-white">
    <div class="container-toven">
      <div class="grid lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-5">
          <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
            The approach
          </p>
          <h2 class="text-4xl md:text-5xl font-extrabold text-ink leading-[1.05] tracking-tight">
            Enterprise discipline.<br />
            <span class="text-ink-subtle">Startup pragmatism.</span>
          </h2>
        </div>
        <div class="lg:col-span-7">
          <p class="text-lg text-ink-muted leading-relaxed mb-6">
            Infrastructure is not glamorous — until it fails. We design systems that stay up, scale smoothly, and never quietly drain your cloud budget.
          </p>
          <p class="text-lg text-ink-muted leading-relaxed">
            Every engagement is led by an IBM-certified Solution Architect with hands-on experience across AWS, GCP, Azure, and IBM Cloud. You get enterprise-grade rigor without enterprise-grade overhead.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- DELIVERABLES -->
  <section class="relative py-32 bg-surface-soft overflow-hidden">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] rounded-full bg-sky-mid/30 blur-3xl pointer-events-none"></div>

    <div class="container-toven relative">
      <div class="max-w-3xl mb-16">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
          What is included
        </p>
        <h2 class="text-4xl md:text-5xl font-extrabold text-ink leading-[1.05] tracking-tight">
          Full-stack<br />
          <span class="text-ink-subtle">infrastructure.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {deliverables.map((item) => (
          <div class="group p-8 rounded-[2rem] bg-white border border-border/60 hover:border-transparent hover:shadow-[0_20px_60px_-15px_rgba(10,14,26,0.12)] transition-all duration-500">
            <div class="w-12 h-12 rounded-xl bg-sky-deep/20 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:rotate-3 transition-all duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-sky-deep" set:html={item.icon} />
            </div>
            <h3 class="text-lg font-bold text-ink mb-3 tracking-tight">{item.title}</h3>
            <p class="text-sm text-ink-muted leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-32 bg-white">
    <div class="container-toven">
      <div class="max-w-3xl mb-20">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
          How we work
        </p>
        <h2 class="text-4xl md:text-5xl font-extrabold text-ink leading-[1.05] tracking-tight">
          Zero downtime.<br />
          <span class="text-ink-subtle">Zero drama.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {process.map((item, i) => {
          const numberColors = [
            'text-sky-accent/40',
            'text-yellow-500/40',
            'text-sky-deep/40',
            'text-red-500/40',
          ];
          return (
            <div class="relative">
              <div class={`text-6xl md:text-7xl font-extrabold mb-4 leading-none ${numberColors[i]}`} style="font-family: var(--font-hero);">
                {item.step}
              </div>
              <h3 class="text-xl font-bold text-ink mb-3 tracking-tight">{item.title}</h3>
              <p class="text-sm text-ink-muted leading-relaxed">{item.description}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- TECH STACK -->
  <section class="py-24 bg-ink text-white">
    <div class="container-toven">
      <div class="max-w-3xl mb-12">
        <p class="text-xs font-semibold text-lime uppercase tracking-[0.2em] mb-4">
          Platforms we work with
        </p>
        <h2 class="text-3xl md:text-4xl font-extrabold leading-[1.1] tracking-tight">
          Multi-cloud.<br />
          <span class="text-white/50">Vendor-neutral.</span>
        </h2>
      </div>

      <div class="flex flex-wrap gap-3">
        {stack.map((tech) => (
          <span class="px-5 py-2.5 rounded-full bg-white/5 border border-white/10 text-sm font-medium text-white/80 hover:bg-white/10 hover:border-white/20 transition-colors">
            {tech}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-white">
    <div class="container-toven">
      <div class="relative rounded-[2.5rem] bg-gradient-sky overflow-hidden p-12 md:p-20 text-center">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full bg-white/40 blur-3xl pointer-events-none"></div>
        <div class="relative">
          <h2 class="text-4xl md:text-5xl font-extrabold text-ink mb-6 leading-[1.05] tracking-tight">
            Infrastructure keeping you up at night?
          </h2>
          <p class="text-lg text-ink-muted max-w-xl mx-auto mb-10">
            Book a discovery call. We will audit what you have and tell you what to fix first.
          </p>
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-ink text-white font-semibold hover:bg-ink-soft transition-colors">
            Book a discovery call →
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>