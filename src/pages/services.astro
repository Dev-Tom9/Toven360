---
import Layout from '../layouts/Layout.astro';
import HeroHeading from '../components/HeroHeading.astro';

const services = [
  {
    num: '01',
    slug: '/services/software-development',
    title: 'Software Development',
    tagline: 'Backend systems, APIs, and full-stack applications.',
    description: 'Custom-built software engineered for scale, security, and long-term maintainability. From API design to production deployments, we own the full stack.',
    deliverables: ['Custom backend systems', 'REST & GraphQL API design', 'Database architecture', 'Full-stack web applications'],
    iconBg: 'bg-sky-accent/15',
    iconColor: 'text-sky-accent',
    icon: `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>`,
    tickColor: 'text-sky-accent',
    linkColor: 'text-sky-accent',
  },
  {
    num: '02',
    slug: '/services/ai-agents',
    title: 'AI Agents & Automation',
    tagline: 'Production AI systems that automate real work.',
    description: 'We design and deploy AI agents that handle real business workflows — not demos. From prompt engineering to autonomous agent orchestration.',
    deliverables: ['Custom AI agents & copilots', 'LLM integration', 'Workflow automation', 'RAG pipelines & vector DBs'],
    iconBg: 'bg-lime/40',
    iconColor: 'text-ink',
    icon: `<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>`,
    tickColor: 'text-yellow-500',
    linkColor: 'text-yellow-600',
  },
  {
    num: '03',
    slug: '/services/infrastructure',
    title: 'Digital Infrastructure',
    tagline: 'Cloud architecture, DevOps, and enterprise infrastructure.',
    description: 'Enterprise-grade infrastructure designed and deployed by an IBM Solution Architect. Built for reliability, cost efficiency, and scale.',
    deliverables: ['Cloud architecture', 'CI/CD pipelines & DevOps', 'Kubernetes & Docker', 'Infrastructure as Code'],
    iconBg: 'bg-sky-deep/20',
    iconColor: 'text-sky-deep',
    icon: `<rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>`,
    tickColor: 'text-sky-deep',
    linkColor: 'text-sky-deep',
  },
  {
    num: '04',
    slug: '/services/technical-consulting',
    title: 'Technical Consulting',
    tagline: 'Senior engineering guidance for teams that need it.',
    description: 'Direct access to a Senior Backend Engineer and IBM Solution Architect. Architecture reviews, technical due diligence, and strategic guidance.',
    deliverables: ['Architecture reviews', 'Technical due diligence', 'Team mentoring', 'Fractional engineering leadership'],
    iconBg: 'bg-ink/10',
    iconColor: 'text-ink',
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
    tickColor: 'text-red-500',
    linkColor: 'text-red-500',
  },
];

const spans = ['lg:col-span-7', 'lg:col-span-5', 'lg:col-span-5', 'lg:col-span-7'];
---

<Layout
  title="Services — Toven360°"
  description="Software development, AI agents, digital infrastructure, and technical consulting — engineered by senior talent for businesses worldwide."
>

  <!-- HERO — left aligned, tight top -->
  <section class="relative gradient-sky pt-10 pb-12 md:pt-14 md:pb-16 overflow-hidden">
    <div class="container-toven relative z-10">
      <div class="max-w-4xl">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-6">
          Services
        </p>
        <HeroHeading
          before="Four pillars."
          highlight="One"
          after="engineering standard."
          rotate="right"
          color="lime"
          size="lg"
          class="mb-8"
        />
        <p class="text-lg md:text-xl text-ink-muted max-w-2xl leading-relaxed">
          Every Toven360° engagement is led by senior engineering talent — not sales teams. Here's what we build.
        </p>
      </div>
    </div>
  </section>

  <!-- SERVICES GRID -->
  <section class="relative py-32 bg-white overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] rounded-full bg-sky-light/40 blur-3xl"></div>
    </div>

    <div class="container-toven relative">

      <div class="max-w-3xl mb-20">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
          What we build
        </p>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-ink leading-[1.05] tracking-tight">
          Four disciplines.<br />
          <span class="text-ink-subtle">One obsession —</span><br />
          systems that work.
        </h2>
      </div>

      <div class="grid lg:grid-cols-12 gap-6">

        {services.map((service, i) => (
          <a
            href={service.slug}
            class={`group relative ${spans[i]} p-10 lg:p-12 pt-16 lg:pt-20 rounded-[2rem] bg-white border border-border/60 hover:border-transparent hover:shadow-[0_20px_60px_-15px_rgba(10,14,26,0.15)] hover:-translate-y-1 transition-all duration-500 overflow-hidden`}
          >
            <div class="absolute -top-24 -right-24 w-48 h-48 rounded-full blur-3xl opacity-0 group-hover:opacity-40 transition-opacity duration-700 bg-gradient-to-br from-sky-light to-sky-mid"></div>

            <!-- BIG NUMBER TOP-RIGHT -->
            <span
              class={`absolute top-6 right-8 font-extrabold text-5xl lg:text-6xl leading-none select-none ${service.tickColor} opacity-90`}
              style="font-family: var(--font-hero);"
            >
              {service.num}
            </span>

            <div class="relative">

              <div class={`w-14 h-14 rounded-2xl ${service.iconBg} flex items-center justify-center mb-8 group-hover:scale-110 group-hover:rotate-3 transition-all duration-500`}>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={service.iconColor}
                  set:html={service.icon}
                />
              </div>

              <h3 class="text-2xl lg:text-3xl font-bold text-ink mb-3 tracking-tight">
                {service.title}
              </h3>

              <p class="text-sky-accent font-medium mb-5 text-[15px]">
                {service.tagline}
              </p>

              <p class="text-ink-muted leading-relaxed mb-8 max-w-lg">
                {service.description}
              </p>

              <ul class="space-y-3 mb-8">
                {service.deliverables.map((item) => (
                  <li class="flex items-start gap-3 text-sm text-ink-muted">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class={`${service.tickColor} mt-0.5 flex-shrink-0`}
                    >
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <div class={`flex items-center gap-2 text-sm font-bold ${service.linkColor}`}>
                <span class="border-b border-transparent group-hover:border-current transition-colors pb-0.5">
                  Explore this service
                </span>
                <span class="inline-flex items-center justify-center transition-all duration-500 group-hover:translate-x-1 group-hover:scale-125">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                  </svg>
                </span>
              </div>

            </div>
          </a>
        ))}

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-ink text-white">
    <div class="container-toven text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        Not sure where to start?
      </h2>
      <p class="text-lg text-white/70 max-w-2xl mx-auto mb-10">
        Book a discovery call. We'll help you scope the right engagement — no obligation.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-lime text-ink font-semibold hover:bg-lime-hover transition-colors"
      >
        Book a discovery call →
      </a>
    </div>
  </section>

</Layout>