---
import Layout from '../layouts/Layout.astro';
import HeroHeading from '../components/HeroHeading.astro';

const engagementModels = [
  {
    name: 'Sprint',
    tagline: 'For quick builds & focused deliverables.',
    price: 'From $5,000',
    period: 'per 2-week sprint',
    description: 'A focused, time-boxed engagement to ship a specific outcome — an MVP, an integration, or a proof of concept.',
    features: [
      '2-week focused delivery window',
      'Direct access to a senior engineer',
      'Weekly progress demos',
      'Documented handover',
      'One revision round included',
    ],
    cta: 'Start a sprint',
    featured: false,
  },
  {
    name: 'Project',
    tagline: 'For full builds, start to finish.',
    price: 'From $15,000',
    period: 'per project',
    description: 'End-to-end delivery of a complete system — architected, built, tested, and deployed with full documentation.',
    features: [
      'Full discovery & architecture phase',
      'End-to-end engineering delivery',
      'CI/CD pipeline setup',
      'Production deployment',
      'Post-launch support (30 days)',
      'Full documentation & handover',
    ],
    cta: 'Scope a project',
    featured: true,
  },
  {
    name: 'Retainer',
    tagline: 'For ongoing engineering partnership.',
    price: 'From $6,000',
    period: 'per month',
    description: 'Continuous engineering capacity for teams that need senior talent on demand — without a full-time hire.',
    features: [
      'Reserved monthly capacity',
      'Priority response times',
      'Architecture & code reviews',
      'Team mentoring & upskilling',
      'Rolling backlog management',
      'Flexible scope each month',
    ],
    cta: 'Discuss retainer',
    featured: false,
  },
];

const consulting = [
  { name: 'Architecture Review', price: 'From $3,000', description: 'Deep-dive audit of your current systems with a written report and prioritized roadmap.' },
  { name: 'Technical Due Diligence', price: 'From $5,000', description: 'Independent engineering assessment for investors, acquisitions, or partnerships.' },
  { name: 'Fractional CTO', price: 'From $8,000 / month', description: 'Senior engineering leadership on a flexible basis — strategic guidance without a full-time hire.' },
  { name: 'Team Mentoring', price: 'From $2,000 / month', description: 'Regular sessions with your engineers to level up delivery, code quality, and architecture.' },
];

const caseStudies = [
  { category: 'AI Recruitment', title: 'HireLogic', description: 'AI recruitment platform with CV parsing, candidate ranking, and interview question generation.', metric: '65%', metricLabel: 'faster candidate screening', tags: 'Python · FastAPI · ChromaDB' },
  { category: 'Workflow Automation', title: 'Nexus AI-Ops', description: 'Internal AI automation platform for document summarization, report writing, and email drafting.', metric: '40%', metricLabel: 'reduction in task workload', tags: 'Python · FastAPI · React' },
  { category: 'Healthcare', title: 'Westend HMS', description: 'Full hospital management system with biometric attendance integration, built end-to-end.', metric: 'Live', metricLabel: 'in production today', tags: 'PHP · Laravel · SQL' },
  { category: 'Insurance', title: 'CoverX', description: 'Health-tech insurance platform for enrollment, provider verification, and claims processing.', metric: 'Live', metricLabel: 'in production today', tags: 'Healthcare · Insurance' },
  { category: 'Laboratory', title: 'Safaricollab', description: 'Laboratory management application with role-based access control across all staff roles.', metric: 'Live', metricLabel: 'in production today', tags: 'PHP · Laravel · SQL' },
  { category: 'Network / Data', title: 'EcoFiberX', description: 'Self-service platform for router customers to subscribe to monthly internet data plans.', metric: 'Live', metricLabel: 'on Google Play Store', tags: 'Full-stack · Android' },
];

const faqs = [
  { q: 'How do you price projects?', a: 'After a discovery call, we scope the work and provide a fixed-price quote. No hourly billing surprises — you know what you are paying for before we start.' },
  { q: 'What currencies do you accept?', a: 'USD primary. EUR, GBP, and NGN also accepted. Payment via Stripe or Paystack — both secure and internationally recognized.' },
  { q: 'Do you require a deposit?', a: 'Yes — 50% upfront, 50% on delivery. For larger projects, we split payments across milestones. All terms are agreed in writing before we start.' },
  { q: 'Can we start small before committing?', a: 'Absolutely. Most clients start with a Sprint or an Architecture Review to test the fit before moving to a larger engagement.' },
  { q: 'Do you offer equity or revenue-share deals?', a: 'Selectively, for the right partnership. Bring it up in the discovery call — we are open to discussing it.' },
  { q: 'What if the project scope changes?', a: 'We handle it transparently. Small shifts are absorbed. Significant scope changes get a written change order with updated pricing.' },
];
---

<Layout
  title="Pricing — Toven360°"
  description="Transparent engagement models for software development, AI agents, digital infrastructure, and technical consulting. Senior engineering, globally available."
>

  <!-- HERO -->
  <section class="relative gradient-sky pt-10 pb-12 md:pt-14 md:pb-16 overflow-hidden">
    <div class="container-toven relative z-10">
      <div class="max-w-4xl">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-6">
          Pricing & Engagement Models
        </p>
        <HeroHeading
          before="Clear pricing."
          highlight="No"
          after="hidden fees."
          rotate="right"
          color="lime"
          size="lg"
          class="mb-8"
        />
        <p class="text-lg md:text-xl text-ink-muted max-w-2xl leading-relaxed">
          Three ways to work with us, plus focused consulting engagements. Every price is a starting point — final scope is agreed after a discovery call.
        </p>
      </div>
    </div>
  </section>

  <!-- ENGAGEMENT MODELS -->
  <section class="relative py-32 bg-white overflow-hidden">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] rounded-full bg-sky-light/40 blur-3xl pointer-events-none"></div>

    <div class="container-toven relative">

      <div class="max-w-3xl mb-20">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
          Engagement models
        </p>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-ink leading-[1.05] tracking-tight">
          Three ways<br />
          <span class="text-ink-subtle">to work with us.</span>
        </h2>
      </div>

      <div class="grid lg:grid-cols-3 gap-6">

        {engagementModels.map((model) => (
          <div class={`group relative rounded-[2.5rem] overflow-hidden transition-all duration-500 hover:-translate-y-2 ${
            model.featured
              ? 'bg-ink text-white shadow-[0_30px_80px_-20px_rgba(10,14,26,0.35)]'
              : 'bg-surface-soft border border-border/60 hover:shadow-[0_30px_80px_-20px_rgba(10,14,26,0.18)]'
          }`}>

            {model.featured && (
              <>
                <div class="absolute top-0 right-0 w-[400px] h-[400px] rounded-full bg-sky-accent/20 blur-3xl pointer-events-none"></div>
                <div class="absolute bottom-0 left-0 w-[300px] h-[300px] rounded-full bg-lime/10 blur-3xl pointer-events-none"></div>
              </>
            )}

            <div class="relative p-10 lg:p-12 flex flex-col h-full">

              {model.featured && (
                <div class="inline-flex self-start items-center gap-2 px-3 py-1.5 rounded-full bg-lime text-ink text-xs font-semibold uppercase tracking-widest mb-6 font-hero" style="font-family: var(--font-hero);">
                  Most popular
                </div>
              )}

              <h3 class={`text-3xl font-bold mb-2 tracking-tight ${model.featured ? 'text-white' : 'text-ink'}`} style="font-family: var(--font-hero);">
                {model.name}
              </h3>

              <p class={`mb-8 ${model.featured ? 'text-white/60' : 'text-ink-muted'}`}>
                {model.tagline}
              </p>

              <div class="mb-8">
                <p class={`text-4xl lg:text-5xl font-extrabold tracking-tight ${model.featured ? 'text-lime' : 'text-ink'}`} style="font-family: var(--font-hero);">
                  {model.price}
                </p>
                <p class={`text-sm mt-1 ${model.featured ? 'text-white/50' : 'text-ink-subtle'}`}>
                  {model.period}
                </p>
              </div>

              <p class={`mb-8 leading-relaxed ${model.featured ? 'text-white/70' : 'text-ink-muted'}`}>
                {model.description}
              </p>

              <ul class="space-y-3 mb-10 flex-1">
                {model.features.map((feature) => (
                  <li class={`flex items-start gap-3 text-sm ${model.featured ? 'text-white/80' : 'text-ink-muted'}`}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class={`mt-0.5 flex-shrink-0 ${model.featured ? 'text-lime' : 'text-sky-accent'}`}>
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>

              <a
                href="/contact"
                class={`inline-flex items-center justify-center gap-2 w-full px-8 py-4 rounded-full font-semibold transition-colors ${
                  model.featured
                    ? 'bg-lime text-ink hover:bg-lime-hover'
                    : 'bg-ink text-white hover:bg-ink-soft'
                }`}
              >
                {model.cta}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </a>

            </div>

          </div>
        ))}

      </div>

      <p class="text-sm text-ink-subtle mt-8">
        USD primary. EUR, GBP, and NGN also accepted. Payment via Stripe or Paystack.
      </p>

    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="py-32 bg-surface-soft">
    <div class="container-toven">

      <div class="max-w-3xl mb-16">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
          Selected work
        </p>
        <h2 class="text-4xl md:text-5xl font-extrabold text-ink leading-[1.05] tracking-tight">
          Built. Shipped.<br />
          <span class="text-ink-subtle">Live in production.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {caseStudies.map((item) => (
          <div class="group p-8 rounded-[2rem] bg-white border border-border/60 hover:border-transparent hover:shadow-[0_20px_60px_-15px_rgba(10,14,26,0.12)] transition-all duration-500 flex flex-col">
            <p class="text-xs font-semibold text-sky-accent uppercase tracking-widest mb-4">
              {item.category}
            </p>

            <h3 class="text-xl font-bold text-ink mb-3 tracking-tight" style="font-family: var(--font-hero);">{item.title}</h3>

            <p class="text-sm text-ink-muted leading-relaxed mb-6 flex-1">{item.description}</p>

            <div class="pt-6 border-t border-border">
              <p class="text-3xl font-extrabold text-ink tracking-tight">{item.metric}</p>
              <p class="text-xs text-ink-subtle mt-1">{item.metricLabel}</p>
            </div>

            <p class="text-xs text-ink-subtle mt-4 font-medium">{item.tags}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- CONSULTING -->
  <section class="py-32 bg-white">
    <div class="container-toven">

      <div class="max-w-3xl mb-16">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
          Consulting engagements
        </p>
        <h2 class="text-4xl md:text-5xl font-extrabold text-ink leading-[1.05] tracking-tight">
          Focused work.<br />
          <span class="text-ink-subtle">Fixed pricing.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {consulting.map((item) => (
          <div class="group p-10 rounded-[2.5rem] bg-surface-soft border border-border/60 hover:border-transparent hover:shadow-[0_20px_60px_-15px_rgba(10,14,26,0.12)] hover:-translate-y-1 transition-all duration-500">
            <div class="flex items-start justify-between gap-6 mb-6">
              <h3 class="text-2xl font-bold text-ink tracking-tight" style="font-family: var(--font-hero);">{item.name}</h3>
              <span class="text-sm font-semibold text-sky-accent whitespace-nowrap px-3 py-1.5 rounded-full bg-sky-accent/10">
                {item.price}
              </span>
            </div>
            <p class="text-ink-muted leading-relaxed mb-8">{item.description}</p>
            <a href="/contact" class="inline-flex items-center gap-2 text-sm font-semibold text-ink group-hover:gap-3 transition-all">
              Enquire
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- FAQ -->
  <section class="py-32 bg-surface-soft">
    <div class="container-toven">

      <div class="grid lg:grid-cols-12 gap-16 items-start">

        <div class="lg:col-span-5 lg:sticky lg:top-32">
          <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-4">
            FAQ
          </p>
          <h2 class="text-4xl md:text-5xl font-extrabold text-ink leading-[1.05] tracking-tight mb-6">
            Questions.<br />
            <span class="text-ink-subtle">Answered.</span>
          </h2>
          <p class="text-lg text-ink-muted leading-relaxed mb-8">
            Still unsure? Book a discovery call — we will answer everything in person.
          </p>
          <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-ink text-white text-sm font-semibold hover:bg-ink-soft transition-colors">
            Book a call →
          </a>
        </div>

        <div class="lg:col-span-7">
          <div class="space-y-3" id="faq-list">
            {faqs.map((faq) => (
              <div class="faq-item rounded-[2rem] bg-white border border-border/60 hover:border-sky-accent/60 hover:shadow-[0_20px_60px_-15px_rgba(58,143,212,0.15)] overflow-hidden transition-all duration-500">
                <button
                  type="button"
                  class="faq-trigger w-full flex items-center justify-between gap-6 p-7 text-left"
                  aria-expanded="false"
                >
                  <span class="text-lg font-bold text-ink tracking-tight pr-4">{faq.q}</span>
                  <span class="faq-icon flex-shrink-0 w-8 h-8 rounded-full bg-surface-soft flex items-center justify-center relative transition-all duration-500">
                    <span class="absolute w-3 h-[2px] bg-ink rounded-full"></span>
                    <span class="faq-icon-vertical absolute w-3 h-[2px] bg-ink rounded-full rotate-90 transition-transform duration-500"></span>
                  </span>
                </button>
                <div class="faq-content grid grid-rows-[0fr] transition-all duration-500 ease-out">
                  <div class="overflow-hidden">
                    <p class="px-7 pb-7 text-ink-muted leading-relaxed">{faq.a}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-white">
    <div class="container-toven">
      <div class="relative rounded-[2.5rem] bg-gradient-sky overflow-hidden p-12 md:p-20 text-center">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full bg-white/40 blur-3xl pointer-events-none"></div>
        <div class="relative">
          <h2 class="text-4xl md:text-5xl font-extrabold text-ink mb-6 leading-[1.05] tracking-tight">
            Not sure which model fits?
          </h2>
          <p class="text-lg text-ink-muted max-w-xl mx-auto mb-10">
            Book a discovery call. We will help you scope it honestly — no obligation.
          </p>
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-ink text-white font-semibold hover:bg-ink-soft transition-colors">
            Book a discovery call →
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  const triggers = document.querySelectorAll('.faq-trigger');

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const content = item?.querySelector('.faq-content') as HTMLElement;
      const icon = item?.querySelector('.faq-icon-vertical') as HTMLElement;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      document.querySelectorAll('.faq-trigger').forEach((t) => {
        if (t !== trigger) {
          t.setAttribute('aria-expanded', 'false');
          const otherItem = t.closest('.faq-item');
          const otherContent = otherItem?.querySelector('.faq-content') as HTMLElement;
          const otherIcon = otherItem?.querySelector('.faq-icon-vertical') as HTMLElement;
          if (otherContent) otherContent.style.gridTemplateRows = '0fr';
          if (otherIcon) otherIcon.style.transform = 'rotate(90deg)';
        }
      });

      if (isOpen) {
        trigger.setAttribute('aria-expanded', 'false');
        if (content) content.style.gridTemplateRows = '0fr';
        if (icon) icon.style.transform = 'rotate(90deg)';
      } else {
        trigger.setAttribute('aria-expanded', 'true');
        if (content) content.style.gridTemplateRows = '1fr';
        if (icon) icon.style.transform = 'rotate(0deg)';
      }
    });
  });
</script>