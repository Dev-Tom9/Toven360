---
import Layout from '../layouts/Layout.astro';
import HeroHeading from '../components/HeroHeading.astro';
import { statSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const filePath = fileURLToPath(import.meta.url);
const lastUpdated = new Date(statSync(filePath).mtime).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const sections = [
  { num: '01', title: 'Agreement to Terms', content: 'By accessing or using the Toven360° website and services, you agree to be bound by these Terms. If you do not agree, please do not use our services.', icon: '<path d="M9 12l2 2 4-4"/><path d="M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9c1.66 0 3.22.45 4.56 1.24"/>', theme: 'bright' },
  { num: '02', title: 'Services', content: 'Toven360° provides software development, AI agents and automation, digital infrastructure, and technical consulting. Terms for each engagement are agreed in writing before work begins.', icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>', theme: 'cream' },
  { num: '03', title: 'Client Responsibilities', content: 'Clients agree to provide accurate information, timely feedback, and any materials reasonably required to deliver the agreed services.', icon: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>', theme: 'bright' },
  { num: '04', title: 'Payments', content: 'Engagements are billed 50% upfront, 50% on delivery unless agreed otherwise. Larger projects may be split across milestones. Payments via Stripe or Paystack.', icon: '<rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/>', theme: 'cream' },
  { num: '05', title: 'Intellectual Property', content: 'Upon full payment, clients own the deliverables produced for them, excluding pre-existing tools and frameworks. We may reference completed work unless a confidentiality agreement says otherwise.', icon: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 9h6v6H9z"/>', theme: 'bright' },
  { num: '06', title: 'Confidentiality', content: 'Both parties agree to keep confidential any proprietary or sensitive information shared during the engagement. This obligation survives termination.', icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 11v4"/>', theme: 'cream' },
  { num: '07', title: 'Limitation of Liability', content: 'We provide services with professional care and skill, but do not warrant deliverables will be error-free. Total liability is limited to fees paid for the specific engagement.', icon: '<circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/>', theme: 'bright' },
  { num: '08', title: 'Termination', content: 'Either party may terminate an engagement with written notice. Fees for work completed up to the termination date remain payable.', icon: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>', theme: 'cream' },
  { num: '09', title: 'Governing Law', content: 'These terms are governed by the laws of the Federal Republic of Nigeria. Disputes will be resolved in good faith and, if necessary, in the courts of Nigeria.', icon: '<path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/>', theme: 'bright' },
  { num: '10', title: 'Changes to Terms', content: 'We may update these Terms from time to time. Continued use of our services after changes constitutes acceptance.', icon: '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>', theme: 'cream' },
  { num: '11', title: 'Contact', content: 'Questions? Reach us at <a href="mailto:thetovengroup@gmail.com" class="underline font-semibold">thetovengroup@gmail.com</a>. We respond within 24 hours.', icon: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>', theme: 'bright' },
];
---

<Layout
  title="Terms of Service — Toven360°"
  description="Terms and conditions for using the Toven360° website and services."
>

  <!-- HERO -->
  <section class="relative gradient-sky pt-10 pb-12 md:pt-14 md:pb-16 overflow-hidden">
    <div class="container-toven relative z-10">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold text-sky-accent uppercase tracking-[0.2em] mb-6">
          Legal
        </p>
        <HeroHeading
          before="Terms of"
          highlight="Service"
          rotate="left"
          color="lime"
          size="lg"
        />
        <p class="text-lg text-ink-muted leading-relaxed mt-8">
          Last updated: {lastUpdated}
        </p>
      </div>
    </div>
  </section>

  <!-- SCROLL-PINNED HORIZONTAL SECTION -->
  <section id="scroll-section" class="relative bg-white">
    <div class="scroll-pin-wrapper">
      <div class="scroll-pin-inner">

        <div class="carousel-viewport">
          <div class="carousel-track" id="carousel-track">
            {sections.map((section, i) => (
              <div class="carousel-card" style={`--i: ${i};`}>
                <div class={`carousel-card-inner ${section.theme === 'bright' ? 'carousel-bright' : 'carousel-cream'}`}>

                  <div class={`w-11 h-11 rounded-full flex items-center justify-center mb-5 ${section.theme === 'bright' ? 'bg-white/25 border-2 border-white/60' : 'bg-sky-accent/10 border-2 border-sky-accent/40'}`}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={section.theme === 'bright' ? 'text-white' : 'text-sky-accent'} set:html={section.icon} />
                  </div>

                  <span class={`text-[10px] font-bold uppercase tracking-[0.2em] ${section.theme === 'bright' ? 'text-white/80' : 'text-sky-accent'}`}>
                    Step {section.num}
                  </span>

                  <h3 class={`text-lg font-extrabold mt-1 mb-2 leading-[1.15] tracking-tight ${section.theme === 'bright' ? 'text-white' : 'text-ink'}`}>
                    {section.title}
                  </h3>

                  <p class={`text-[13px] leading-relaxed ${section.theme === 'bright' ? 'text-white/90' : 'text-ink-muted'} relative z-10`} set:html={section.content} />

                  <span class={`ghost-number ${section.theme === 'bright' ? 'ghost-bright' : 'ghost-cream'} ${i % 2 === 0 ? 'ghost-bottom' : 'ghost-top'}`}>
                    {section.num}
                  </span>

                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="flex justify-center gap-2 mt-8" id="carousel-dots">
          {sections.map((_, i) => (
            <span class="carousel-dot w-2 h-2 rounded-full bg-sky-light transition-all duration-500" data-index={i}></span>
          ))}
        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
  #scroll-section {
    position: relative;
    height: 500vh;
  }

  .scroll-pin-wrapper {
    position: sticky;
    top: 80px;
    height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .scroll-pin-inner {
    width: 100%;
  }

  .carousel-viewport {
    overflow: visible;
    padding: 0 24px;
  }

  .carousel-track {
    display: flex;
    gap: 32px;
    width: max-content;
    will-change: transform;
    transform: translateX(0);
  }

  .carousel-card {
    flex-shrink: 0;
    width: 240px;
  }

  @media (min-width: 640px) {
    .carousel-card { width: 260px; }
  }

  @media (min-width: 1024px) {
    .carousel-card { width: 280px; }
  }

  .carousel-card-inner {
    border-radius: 1.75rem;
    padding: 1.75rem;
    box-shadow: 0 15px 45px -15px rgba(10, 14, 26, 0.12);
    animation: float-card 5s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.25s);
    height: 100%;
    position: relative;
    overflow: hidden;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    isolation: isolate;
  }

  .carousel-bright {
    background: linear-gradient(135deg, #6bb6e8 0%, #3a8fd4 100%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 15px 45px -15px rgba(58, 143, 212, 0.35);
  }

  .carousel-cream {
    background-color: #f7f9fc;
    border: 1px solid rgba(229, 234, 240, 0.8);
  }

  .ghost-number {
    position: absolute;
    font-family: var(--font-hero);
    font-weight: 800;
    font-size: 120px;
    line-height: 0.85;
    letter-spacing: -0.06em;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .ghost-bottom {
    bottom: -24px;
    right: -8px;
  }

  .ghost-top {
    top: -24px;
    right: -8px;
  }

  .ghost-bright {
    color: rgba(255, 255, 255, 0.22);
  }

  .ghost-cream {
    color: rgba(10, 14, 26, 0.08);
  }

  @keyframes float-card {
    0%, 100% { transform: translateY(0px) rotate(-0.4deg); }
    50% { transform: translateY(-8px) rotate(0.4deg); }
  }

  .carousel-dot.active {
    background-color: #3a8fd4;
    width: 24px;
  }
</style>

<script>
  const section = document.getElementById('scroll-section');
  const track = document.getElementById('carousel-track');
  const dots = document.querySelectorAll('.carousel-dot');

  let targetX = 0;
  let currentX = 0;
  let rafId: number | null = null;

  const computeTarget = () => {
    if (!section || !track) return;

    // Force layout read (avoids stale dimensions from earlier render)
    const sectionRect = section.getBoundingClientRect();
    const sectionHeight = section.offsetHeight;
    const windowHeight = window.innerHeight;
    const viewportWidth = window.innerWidth;
    const trackWidth = track.scrollWidth;

    const scrollable = sectionHeight - windowHeight;
    const scrolled = Math.max(0, Math.min(scrollable, -sectionRect.top));
    const progress = scrollable > 0 ? scrolled / scrollable : 0;

    const maxShift = Math.max(0, trackWidth - viewportWidth + 48);
    targetX = -progress * maxShift;

    const activeIndex = Math.round(progress * (dots.length - 1));
    dots.forEach((dot, i) => {
      if (i === activeIndex) dot.classList.add('active');
      else dot.classList.remove('active');
    });
  };

  const animate = () => {
    currentX += (targetX - currentX) * 0.08;
    if (track) {
      track.style.transform = `translate3d(${currentX}px, 0, 0)`;
    }
    rafId = requestAnimationFrame(animate);
  };

  // Recompute on every relevant event
  const recompute = () => {
    computeTarget();
    // Snap current to target on recompute to avoid visible catch-up
    if (Math.abs(currentX - targetX) > 200) {
      currentX = targetX;
    }
  };

  window.addEventListener('scroll', computeTarget, { passive: true });
  window.addEventListener('resize', recompute);

  // Recompute after fonts load (fixes first-load issue where custom fonts shift layout)
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(recompute);
  }

  // Recompute after all images load
  window.addEventListener('load', recompute);

  // Recompute when the section itself resizes
  if (section && 'ResizeObserver' in window) {
    const ro = new ResizeObserver(() => computeTarget());
    ro.observe(section);
  }

  // Recompute after Swup navigations (in case we arrive via client-side routing)
  document.addEventListener('swup:contentReplaced', () => setTimeout(recompute, 100));
  document.addEventListener('swup:page:view', () => setTimeout(recompute, 100));
  document.addEventListener('astro:page-load', () => setTimeout(recompute, 100));

  // Initial
  computeTarget();
  currentX = targetX;
  animate();

  // Extra safety: recompute again after 500ms and 1.5s (covers slow layout shifts)
  setTimeout(recompute, 500);
  setTimeout(recompute, 1500);
</script>